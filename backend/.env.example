# CampusPulse Backend Environment Configuration
APP_NAME=CampusPulse
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-insecure-secret-key-replace-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campuspulse
DATABASE_TEST_URL=sqlite:///./test.db
