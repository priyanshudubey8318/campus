# CampusPulse — Root Environment Configuration Template
# Copy to .env for local overrides (never commit actual secrets)

# --- Application ---
APP_NAME=CampusPulse
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# For Docker Compose: postgresql://postgres:postgres@db:5432/campuspulse
# For local fallback development: postgresql://postgres:postgres@localhost:5432/campuspulse
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campuspulse
DATABASE_TEST_URL=sqlite:///./test.db

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# --- Future Extension Placeholders (Disabled in Phase 0) ---
# FEATURE_PULSEWATCH=false
# FEATURE_PULSERISK=false
# FEATURE_PULSEASSIST=false
# GEMINI_API_KEY=
# CHROMA_DB_PATH=
